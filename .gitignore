# ==============================================================================
# MediReach - Comprehensive Git Ignore
# Covers: Flutter, Android, iOS, Node.js Gateway, Python/ML, Secrets & Binaries
# ==============================================================================

# ------------------------------------------------------------------------------
# Security, Environment Variables & Secret Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example

# Service Account Keys & Secrets
*service-account*.json
firebase-service-account*.json
**/config/firebase-service-account*.json

# Mobile Credentials & Keystores
**/android/local.properties
**/android/key.properties
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# Executables, Binaries & Downloaded Tools
# ------------------------------------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.app
cloudflared.exe
cloudflared

# ------------------------------------------------------------------------------
# Node.js / Express Gateway
# ------------------------------------------------------------------------------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Python & Machine Learning Service
# ------------------------------------------------------------------------------
**/venv/
**/env/
**/ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.Python
.pytest_cache/
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
*.egg

# ------------------------------------------------------------------------------
# Flutter / Dart / Pub
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.widget_preview/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
.cxx/

# ------------------------------------------------------------------------------
# iOS / macOS
# ------------------------------------------------------------------------------
**/ios/**/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/.last_build_id
**/ios/DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/xcuserdata/

# ------------------------------------------------------------------------------
# IDEs, Code Editors & Temporary Files
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
tempCodeRunnerFile.*
*.swp
*.swo
*~
*.bak
*.tmp
.history/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
